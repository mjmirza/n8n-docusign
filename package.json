{
	"name": "n8n-nodes-docusign",
	"version": "0.1.0",
	"description": "DocuSign eSignature — 4 resources, 15+ operations, webhook triggers for envelope events",
	"license": "MIT",
	"author": {
		"name": "Mirza Iqbal"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"docusign",
		"esignature",
		"signature",
		"envelope",
		"documents",
		"contracts",
		"signing",
		"templates",
		"recipients"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/DocuSignOAuth2Api.credentials.js",
			"dist/credentials/DocuSignJwtApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DocuSign/DocuSign.node.js",
			"dist/nodes/DocuSign/DocuSignTrigger.node.js"
		]
	},
	"main": "index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials --ext .ts",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^20.0.0",
		"gulp": "^4.0.2",
		"jest": "^29.7.0",
		"n8n-workflow": "^1.0.0",
		"prettier": "^3.0.0",
		"ts-jest": "^29.4.6",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
