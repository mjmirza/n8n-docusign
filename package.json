{
  "name": "n8n-nodes-docusigns",
  "version": "3.3.0",
  "description": "DocuSign eSignature for n8n. 80 resources, 349 operations and envelope event triggers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjmirza/n8n-docusign.git"
  },
  "homepage": "https://next8n.com",
  "bugs": {
    "url": "https://github.com/mjmirza/n8n-docusign/issues"
  },
  "author": {
    "name": "Mirza Iqbal",
    "email": "support@next8n.com",
    "url": "https://next8n.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "docusign",
    "esignature",
    "signature",
    "envelope",
    "documents",
    "contracts",
    "signing",
    "templates",
    "recipients"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DocuSignOAuth2Api.credentials.js",
      "dist/credentials/DocuSignJwtApi.credentials.js",
      "dist/credentials/DocuSignConnectHmacApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DocuSign/DocuSign.node.js",
      "dist/nodes/DocuSign/DocuSignTrigger.node.js"
    ]
  },
  "files": [
    "dist",
    "docs/TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint:n8n": "node scripts/n8n-scan.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "gulp": "^5.0.1",
    "jest": "^30.5.2",
    "n8n-workflow": "2.45.4",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
